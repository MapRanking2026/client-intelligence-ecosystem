{
  "name": "client-intelligence-ecosystem",
  "private": true,
  "version": "0.0.0",
  "description": "Client Intelligence Ecosystem monorepo: MTOS (account management) + SEOOS (SEO operations) + shared packages.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/mtos",
    "dev:mtos": "npm run dev -w apps/mtos",
    "build": "npm run build -w apps/mtos",
    "build:mtos": "npm run build -w apps/mtos",
    "check": "npm run check -w apps/mtos",
    "check:mtos": "npm run check -w apps/mtos",
    "lint": "npm run lint -w apps/mtos"
  },
  "engines": {
    "node": ">=20"
  }
}
