NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase auth and persistence
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Session and app security
SESSION_COOKIE_NAME=mtos_session
SESSION_COOKIE_SECRET=
MTOS_INTEGRATIONS_SECRET=
PILOT_LOGIN_CODE=

# ClickUp pilot integration
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_REDIRECT_URI=
CLICKUP_WEBHOOK_SECRET=

# Shared Google OAuth client for GBP / Search Console / Ads / Analytics / Drive / Gmail
GOOGLE_INTEGRATIONS_CLIENT_ID=
GOOGLE_INTEGRATIONS_CLIENT_SECRET=

# Meta Ads OAuth
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=

# GoHighLevel OAuth
GOHIGHLEVEL_CLIENT_ID=
GOHIGHLEVEL_CLIENT_SECRET=
# Optional authorize URL override for white-label installs.
# Standard: https://marketplace.gohighlevel.com/oauth/chooselocation
# White-label: https://marketplace.leadconnectorhq.com/oauth/chooselocation
GOHIGHLEVEL_AUTH_URL=

# QuickBooks OAuth
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# Pilot controls
MTOS_PILOT_TENANT_ID=map-ranking
MTOS_USE_SEED_DATA=false

MTOS_TENANT_ID=
MTOS_DEMO_TENANT_ID=
MTOS_ADMIN_EMAIL=
MTOS_ADMIN_PASSWORD=
MTOS_AM_EMAIL=
MTOS_AM_PASSWORD=

MTOS_MANAGER_SIGNUP_CODE=
MTOS_ADMIN_SIGNUP_CODE=

CLICKUP_HEALTH_TRACKER_LIST_ID=
CLICKUP_ACCOUNT_MANAGER_FIELD=Account Manager

# Client Intelligence dashboards maintained by the post-meeting dashboard updater.
# These are ClickUp LIST ids (not view URLs). To find one: open any card in the
# Risk Register / Stakeholder Map view; the task's list is the value to use.
# Until set, the step still drafts proposed updates for the AM to apply manually.
CLICKUP_RISK_REGISTER_LIST_ID=
CLICKUP_STAKEHOLDER_MAP_LIST_ID=
