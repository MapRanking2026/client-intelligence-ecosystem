# SEOOS — AI Visibility Tracker environment (template; NO real values here).
# Existing SEOOS variables (Firebase, session, ClickUp, …) are documented in
# docs/seoos/00-current-state.md and are unchanged. Only AI-visibility additions
# and the variables it relies on are listed.

# --- Required for persistence (shared with the rest of SEOOS) ---------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
SESSION_COOKIE_SECRET=
MTOS_PILOT_TENANT_ID=map-ranking
NEXT_PUBLIC_APP_URL=https://your-seoos-domain.example

# --- Scheduler / worker (Vercel Cron sends this as a Bearer token) ----------
CRON_SECRET=

# --- Official-API providers (server-side only; never NEXT_PUBLIC_) ----------
# The tracker reuses the SEOOS keys. Optional AIV_* overrides let you use a
# separate, budget-limited key for measurement.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# AIV_ANTHROPIC_API_KEY=
# AIV_OPENAI_API_KEY=
# AIV_GEMINI_API_KEY=

# --- Optional tuning ---------------------------------------------------------
# AIV_WORKER_BUDGET_MS=240000     # time one invocation spends processing jobs
# AIV_MAX_WORKER_HOPS=40          # max self-chained worker invocations
# AIV_WORKER_ORIGIN=              # base URL the worker calls itself on (defaults to NEXT_PUBLIC_APP_URL)
# AIV_PRICING_JSON=               # override/add model prices, e.g. {"openai:gpt-5.5":{"inputPerMTok":5,"outputPerMTok":30,"perSearch":0.01,"source":"…"}}

# --- Tests only — never set in production -----------------------------------
# AIV_ENABLE_FIXTURE_PROVIDER=true
# AIV_BACKOFF_BASE_MS=50
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
